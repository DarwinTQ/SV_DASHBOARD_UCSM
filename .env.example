# ==========================================================================
# Plantilla de variables de entorno — Sistema de Monitoreo Vehicular UCSM
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas ".env" a un repositorio (contiene secretos).
# ==========================================================================

# --- Servidor Django -------------------------------------------------------
SERVIDOR_HOST=0.0.0.0
SERVIDOR_PUERTO=8000
DJANGO_DEBUG=True
# Clave secreta de Django. Si se deja vacía, el sistema genera una al iniciar
# y lo avisa en consola (no usar esa clave generada en producción).
DJANGO_SECRET_KEY=
# Lista separada por comas, o "*" para aceptar cualquier host (solo LAN/dev).
DJANGO_ALLOWED_HOSTS=*
# URL pública del servidor (se usa en los botones "Ver incidencia" de Telegram).
# Ejemplo: http://192.168.1.10:8000
URL_PUBLICA=
ZONA_HORARIA=America/Lima

# --- Base de datos / archivos ----------------------------------------------
# Rutas opcionales; por defecto se usan db.sqlite3 y media/ en la raíz del proyecto.
SQLITE_RUTA=
MEDIA_ROOT=

# --- Broker MQTT Mosquitto (canal principal nodo <-> servidor) --------------
# El broker corre en esta misma PC: infra\mosquitto\iniciar_mosquitto.bat
MQTT_HOST=127.0.0.1
MQTT_PUERTO=1883
MQTT_USUARIO=servidor
MQTT_CLAVE=ucsm2026servidor
# Prefijo del contrato de tópicos: ucsm/v1/<codigo>/telemetria, /gps, /evento...
MQTT_PREFIJO=ucsm/v1
MQTT_KEEPALIVE=15
MQTT_CLIENT_ID=servidor-ucsm
# True para volcar el rastro GPS a logs/gps_track.csv (evidencia de la tesis).
MQTT_GPS_CSV=False

# --- Nodo ESP32-S3 (API HTTP de respaldo; el canal normal es MQTT) ----------
ESP32_API_KEY=tesis-ucsm-2026
DISPOSITIVO_TIMEOUT_S=10
ESTADO_INTERVALO_S=30

# --- ESP32-CAM (servidor HTTP al que llamamos) ------------------------------
# Formato: "CODIGO1=http://ip1,CODIGO2=http://ip2"
ESP32CAM_URLS=NODO-01=http://10.144.55.120
# Stream MJPEG continuo (puerto 81) que lee ReceptorStreamCamara.
ESP32CAM_STREAM_URLS=NODO-01=http://10.144.55.120:81/stream
ESP32CAM_API_KEY=tesis-ucsm-2026
ESP32CAM_TIMEOUT_S=4
ESP32CAM_FLASH=False
# True para no depender de hardware: usa media/simulacion/*.jpg
ESP32CAM_SIMULADA=False
ESP32CAM_STATUS_S=30
# Tope de cuadros por segundo que entrega la cámara (no saturar el Wi-Fi).
ESP32CAM_FPS_MAX=8

# --- Receptor del stream MJPEG (worker ReceptorStreamCamara) ----------------
STREAM_SEGUNDOS_BUFFER=3
# Cuadros anotados por segundo que se envían al navegador por WebSocket.
STREAM_FPS_NAVEGADOR=5
STREAM_TIMEOUT_S=8
STREAM_RECONEXION_S=3

# --- YOLO (detección) --------------------------------------------------------
# Modelo propio de la tesis: modelos_ia/yolo26_ucsm_best.pt, con las clases
# abriendo_puerta, arma_blanca, arma_fuego, "car broken" y suspicious.
# Vacío = modelos_ia/yolo26n.pt (genérico, clase "person").
YOLO_MODELO=
YOLO_NOMBRE=yolo26n
YOLO_CONFIANZA=0.50
YOLO_CONFIANZA_ALERTA=0.60
# Clases que se le piden al modelo. Deben coincidir EXACTAMENTE con los nombres
# de model.names (ojo: "car broken" lleva espacio, no guion bajo).
YOLO_CLASES=person
YOLO_IMGSZ=640
# "cpu" o "0" si hay GPU CUDA disponible.
YOLO_DEVICE=cpu
# Umbral de alerta por clase; las que no aparezcan usan el del catálogo
# CATALOGO_CLASES_YOLO de config.py (que es quien asocia cada clase con su
# TipoEvento: sin TipoEvento una detección nunca llega a Telegram).
YOLO_CONFIANZA_POR_CLASE=
# Clases que SOLO alertan con el vehículo ESTACIONADO y armado; las demás
# alertan en cualquier modo (un arma es una emergencia también en marcha).
YOLO_CLASES_SOLO_ESTACIONADO=person

# --- Vigilancia visual continua (YOLO sobre la cámara en vivo) --------------
VISION_CONTINUA=True
VISION_INTERVALO_MS=500
VISION_FRAMES_CONFIRMACION=2
VISION_COOLDOWN_S=30

# --- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT_S=10
TELEGRAM_REINTENTOS=3
TELEGRAM_ALERTAR_SIN_PERSONA=True
# False en pruebas/simulación: no llama a la API real de Telegram.
TELEGRAM_HABILITADO=True
# Bot multiusuario (propietario + familiares): consultas y alertas (long polling).
TELEGRAM_BOT_COMANDOS=True
TELEGRAM_POLLING_TIMEOUT_S=25
TELEGRAM_FOTO_TIMEOUT_S=6
# chat_id separados por comas con acceso total a todos los vehículos (soporte/tesista).
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_COMANDOS_POR_MINUTO=20
TELEGRAM_INVITACION_HORAS=24
TELEGRAM_MAX_ACCESOS_POR_VEHICULO=6

# --- Google Maps (opcional; sin clave se usa Leaflet/OpenStreetMap) --------
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING=False
MAPA_ZOOM=16

# --- Umbrales legado (solo la API HTTP de respaldo /api/v1/telemetria/) -----
UMBRAL_IMPACTO_G=0.35
UMBRAL_RUIDO_DB=85
UMBRAL_INCLINACION_DEG=3
UMBRAL_GIRO_DPS=60
UMBRAL_MOVIMIENTO_KMH=8
UMBRAL_COOLDOWN_S=15

# --- Umbrales de las reglas definitivas (se publican en MQTT "config") ------
# Regla 1 — CHOQUE (solo EN_MARCHA): |a| >= choque_g Y sonido >= choque_db
#           dentro de +-choque_ventana_ms.
DET_CHOQUE_G=4.0
DET_CHOQUE_DB=112
DET_CHOQUE_VENTANA_MS=500
# Regla 2 — ROTURA DE VENTANA (solo ESTACIONADO y armado):
#   golpe 150-400 Hz por encima del piso + golpe_baja_db, estallido 3-7 kHz
#   por encima del piso + estallido_alta_db con planitud >= planitud_min,
#   sostenido >= estallido_min_ms dentro de estallido_ventana_ms.
DET_GOLPE_BAJA_DB=15
DET_ESTALLIDO_ALTA_DB=12
DET_PLANITUD_MIN=0.3
DET_ESTALLIDO_VENTANA_MS=300
DET_ESTALLIDO_MIN_MS=150
DET_FUSION_MS=500
DET_VIBRACION_G=0.15
DET_GOLPE_SIN_ESTALLIDO_MS=1000
# MaquinaModo (sin señal de contacto): variación de |a| por ventanas de 1 s.
DET_QUIETO_G=0.05
DET_QUIETO_S=300
DET_MARCHA_S=10

# --- Procesamiento de eventos -------------------------------------------
EVENTOS_HILOS=1
EVENTOS_COLA=50
